# Copie este arquivo:  cp .env.example .env
# O arquivo .env não vai para o Git. Preencha só o que for usar.

# --- Opcional: Google Sheets (só com --sheets) ---
# JSON da conta de serviço do Google Cloud. Compartilhe a planilha com o e-mail da conta (Editor).
GOOGLE_SERVICE_ACCOUNT_GSPREAD_CREDENTIAL=.config/conta-de-servico.json
# Trecho da URL da planilha entre /d/ e /edit
ID_SHEET_GOOGLE=

# --- Opcional: classificação com Claude (só com --classificar ou API classificar=true) ---
# Crie em https://platform.claude.com/settings/keys (ex.: expiração Never)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Obrigatório para a API HTTP / n8n ---
# Senha que você inventa. O n8n envia no header X-API-Key.
# Exemplo: openssl rand -hex 24
API_KEY_OPORTUNIDADES=
